{
  "terminal.integrated.enableImages": true,
  "redhat.telemetry.enabled": false,
  "telemetry.telemetryLevel": "off",
  "workbench.colorTheme": "Kanagawa Dragon",
  // Palette "Slate": kühle Blau-/Grautöne, kein Gelb. Basis: Kanagawa Dragon
  "workbench.colorCustomizations": {
    "[Kanagawa Dragon]": {
      "editor.background": "#171a20",
      "editor.foreground": "#c8ccd4",
      "sideBar.background": "#0f1114",
      "sideBar.border": "#1f232b",
      "editorGroup.border": "#1f232b",
      "activityBar.background": "#0f1114",
      "statusBar.background": "#0f1114",
      "statusBar.foreground": "#8b93a1",
      "statusBar.noFolderForeground": "#8b93a1",
      "statusBarItem.hoverForeground": "#c8ccd4",
      "statusBarItem.prominentForeground": "#c8ccd4",
      "tab.inactiveBackground": "#0f1114",
      "tab.activeBackground": "#171a20",
      "titleBar.activeBackground": "#0f1114",
      "panel.background": "#0f1114",
      "editorLineNumber.foreground": "#4a505c",
      "editorLineNumber.activeForeground": "#9aa3b2",
      "editor.selectionBackground": "#2c3547",
      "editorCursor.foreground": "#8fa6c7",
      "textPreformat.foreground": "#8fb3c9",
      "editor.findMatchBorder": "#8fa6c7",
      "editorWarning.foreground": "#b38a96",
      "list.warningForeground": "#b38a96",
      "editorGutter.modifiedBackground": "#8fa6c7",
      "minimapGutter.modifiedBackground": "#8fa6c7",
      "editorBracketHighlight.foreground2": "#b0a3c4",
      "editorBracketHighlight.foreground5": "#8fb3b0",
      "terminal.ansiYellow": "#8fb3b0",
      "terminal.ansiBrightYellow": "#a9b4b8",
    },
    "statusBar.background": "#0f1114",
    "statusBar.noFolderBackground": "#0f1114",
    "statusBar.debuggingBackground": "#0f1114",
    "statusBar.foreground": "#8ba4b0",
    "statusBar.debuggingForeground": "#8ba4b0",
  },
  "editor.tokenColorCustomizations": {
    "[Kanagawa Dragon]": {
      "comments": "#5f6675",
      "strings": "#8fb39b",
      "keywords": "#a698c9",
      "functions": "#8fa6c7",
      "numbers": "#c49aa8",
      "types": "#8fb3b0",
      "variables": "#c8ccd4",
      "textMateRules": [
        {
          "scope": [
            "entity.name.tag",
            "meta.tag.sgml",
            "variable.other.property",
            "entity.name.type.module",
            "entity.name.namespace",
            "entity.other.attribute-name.class",
            "constant.other.reference.link.markdown",
          ],
          "settings": { "foreground": "#8fb3b0" },
        },
        {
          "scope": ["keyword.operator", "keyword.other.unit"],
          "settings": { "foreground": "#8b93a1" },
        },
        {
          "scope": [
            "constant.numeric",
            "constant.language",
            "support.constant",
            "constant.character",
            "constant.escape",
            "constant.language.boolean",
            "variable.other.enummember",
            "keyword.control.import",
            "keyword.import",
            "meta.import",
            "string.other.link.title.markdown",
          ],
          "settings": { "foreground": "#c49aa8" },
        },
        { "scope": ["string.regexp"], "settings": { "foreground": "#b0a3c4" } },
      ],
    },
  },
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.editor",
    "*.svg": "imagePreview.previewEditor",
  },

  // Aufgeräumter Look
  "workbench.activityBar.location": "hidden",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.enablePreview": false,
  "editor.lineNumbers": "relative",
  "editor.cursorSurroundingLines": 8,
  "editor.scrollBeyondLastLine": false,
  "editor.padding.top": 8,
  "editor.lineHeight": 1.6,
  "editor.folding": false,
  "editor.glyphMargin": false,
  "editor.lightbulb.enabled": "off",
  "workbench.tips.enabled": false,

  // Vim: wie nvim (Leader = Space, ; = :, jk = Esc)
  "vim.leader": "<space>",
  "vim.statusBarColorControl": true,
  "vim.statusBarColors.normal": ["#0f1114", "#8ba4b0"],
  "vim.statusBarColors.insert": ["#0f1114", "#8a9a7b"],
  "vim.statusBarColors.visual": ["#0f1114", "#a292a3"],
  "vim.statusBarColors.visualline": ["#0f1114", "#a292a3"],
  "vim.statusBarColors.visualblock": ["#0f1114", "#a292a3"],
  "vim.statusBarColors.replace": ["#0f1114", "#c4746e"],
  "vim.statusBarColors.commandlineinprogress": ["#0f1114", "#8ea4a2"],
  "vim.statusBarColors.searchinprogressmode": ["#0f1114", "#8ea4a2"],
  "vim.useSystemClipboard": true,
  "vim.hlsearch": true,
  "vim.smartRelativeLine": false,
  "vim.insertModeKeyBindingsNonRecursive": [
    { "before": ["j", "k"], "after": ["<Esc>"] },
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    { "before": [";"], "after": [":"] },
    { "before": ["<leader>", "e"], "commands": ["workbench.view.explorer"] },
    { "before": ["<leader>", "b"], "commands": ["cmake.build"] },
    { "before": ["<leader>", "r"], "commands": ["cmake.debug"] },
    {
      "before": ["<leader>", "f", "f"],
      "commands": ["workbench.action.quickOpen"],
    },
    {
      "before": ["<leader>", "f", "w"],
      "commands": ["workbench.action.findInFiles"],
    },
    {
      "before": ["<leader>", "f", "b"],
      "commands": ["workbench.action.showAllEditors"],
    },
    {
      "before": ["<leader>", "f", "o"],
      "commands": ["workbench.action.openRecent"],
    },
    {
      "before": ["<leader>", "f", "d"],
      "commands": ["workbench.actions.view.problems"],
    },
    {
      "before": ["<leader>", "c", "f"],
      "commands": ["editor.action.formatDocument"],
    },
  ],
  "window.commandCenter": false,
  "workbench.layoutControl.enabled": false,
  "breadcrumbs.enabled": false,
  "editor.minimap.enabled": false,
  "editor.overviewRulerBorder": false,
  "editor.guides.indentation": false,
  "editor.renderLineHighlight": "gutter",
  "editor.cursorBlinking": "solid",
  "explorer.compactFolders": false,
  "workbench.tree.indent": 12,
  "workbench.startupEditor": "none",
  "claudeCode.preferredLocation": "panel",
  "claudeCode.hideOnboarding": true,
  "git.autofetch": true,
  "hediet.vscode-drawio.resizeImages": null,
  // Web: Prettier beim Speichern
  "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][css][scss][html][vue][astro]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "editor.tabSize": 2,
  "editor.detectIndentation": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": true,
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.smoothScrolling": true,
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.astro": true,
    "**/.next": true,
  },
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "astro": "html",
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "git.confirmSync": false,
  "go.toolsManagement.autoUpdate": true,
  "explorer.confirmDragAndDrop": false,
  "[assembly]": {
    "editor.defaultFormatter": "xaver.clang-format",
  },
  "debug.allowBreakpointsEverywhere": true,
  "cmake.showConfigureWithDebuggerNotification": false,
  "editor.accessibilitySupport": "off",
}
